{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "ai-rpg-tauri",
    "version": "0.0.1"
  },
  "tauri": {
    "allowlist": {
      "fs": {
        "all": true,
        "copyFile": false,
        "renameFile": false,
        "scope": ["$RESOURCE"]
      },
      "all": false,
      "shell": {
        "all": false,
        "open": true
      }
    },
    "windows": [
      {
        "title": "AI-RPG | 由AI驅動的RPG遊戲(Beta)",
        "width": 1280,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.blacktea.AIRPG",
      "publisher":"Thomas10409 on Github",
      "shortDescription": "一款由AI驅動的RPG遊戲 | A RPG game powered by AI",
      "longDescription": "一款由AI驅動的RPG遊戲。\n由作者Thomas10409編寫(你可以在Github上找到我)。\n文件完整代碼皆已上傳到Github上開源。\n如需取用請標記來源。\n感謝!\n\nA RPG game powered by AI.\nMade by Thomas10409 (Github).\nAll file has been upload on Github to open source.\nIf you need used it please markup the source.\nThanks!",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    }
  }
}
